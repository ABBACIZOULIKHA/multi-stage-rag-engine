# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM model via OpenRouter (https://openrouter.ai/models).
# Free tier example: nvidia/nemotron-3-super-120b-a12b:free
#
# LLM_PROVIDER selects the backend for the generator:
#   openrouter  -> OpenRouter (needs OPENROUTER_API_KEY)
#   google      -> Google Gemini API via its OpenAI-compatible endpoint
#                  (needs GEMINI_API_KEY, e.g. model ids: gemma-4-31b-it,
#                  gemini-3.8-flash, gemini-3.5-flash-lite)
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=1
LLM_CONTEXT_WINDOW=256000

# Required only when LLM_PROVIDER=google. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models tried in order when the primary generator fails (comma separated).
# Ids must match LLM_PROVIDER. Empty = no fallback.
LLM_FALLBACK_MODELS=

# LlamaParse API key: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-aIrzntqc50pq6zoc5CntiRHSzYkC7o7bmBbWlQMzOlSUijqm

# Qdrant (see docker-compose.yml)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Local embedding + reranking models (sentence-transformers)
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Retrieval / chunking
CHUNKER=markdown        # markdown (structure-aware) | sentence (fixed chunk_size)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=20                # candidates pulled from each leg before reranking
RERANK_TOP_N=3          # final passages passed to the LLM

# Hybrid retrieval (dense + lexical, fused inside Qdrant)
ENABLE_HYBRID=1                    # 0 = dense-only (original behaviour)
SPARSE_MODEL=Qdrant/bm25           # lexical leg: Qdrant/bm25 | prithivida/Splade_pp_en_v1
HYBRID_ALPHA=0.5                   # 0 = pure sparse, 1 = pure dense
SPARSE_TOP_K=20                    # candidates from the sparse leg (defaults to TOP_K)

# Metadata filtering (applied to BOTH the dense and sparse leg before fusion)
FILTERED_FIELDS=file_name,header_path,document_id
# Payload fields to build Qdrant payload indexes for, so filters stay indexed.
# Indexing is created on startup and is safe on an existing collection.
#
# DEFAULT_FILTERS is applied to every query unless --no-default-filters is passed.
# Multiple entries are separated by ";" and are combined with AND.
# Syntax:  key=value   key!=value   key>=value   key<=value   key>value   key<value   key~=value
#   =   exact match          ~=  full-text contains        > >= < <=  numeric range
# Example: DEFAULT_FILTERS=file_name=spec.pdf;header_path~=/Setup
DEFAULT_FILTERS=

# Where to place your PDFs
DATA_DIR=data

# ---------------------------------------------------------------------------
# Evaluation (evaluate.py)
# ---------------------------------------------------------------------------
# Testset in RAGAS format: list of {user_input, reference, reference_contexts, _meta}
EVAL_TESTSET_FILE=Ragas_testset_with_sources.json

# Judge LLM for the RAGAS metrics. Must differ from the generator when possible,
# otherwise self-evaluation bias inflates the scores. The judge is called ~4x per
# answerable item plus 1x per item for abstention.
#
# EVAL_JUDGE_PROVIDER selects where the judge runs:
#   ollama     -> local Ollama OpenAI-compatible endpoint (OLLAMA_BASE_URL).
#                 Free, no key, unlimited. Default: gpt-oss:120b-cloud.
#   openrouter -> OpenRouter (needs OPENROUTER_API_KEY; costs quota or money)
EVAL_JUDGE_PROVIDER=ollama
EVAL_JUDGE_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
EVAL_JUDGE_TEMPERATURE=0
EVAL_JUDGE_MAX_TOKENS=4096

# Which metrics to compute. Available: faithfulness, answer_relevancy,
# context_precision, context_recall
EVAL_METRICS=faithfulness,answer_relevancy,context_precision,context_recall

# Concurrent judge calls. Raise for throughput, lower if the judge rate-limits.
EVAL_BATCH_SIZE=8

# Judge embedding model. Defaults to EMBED_MODEL (BAAI/bge-m3, local).
# Set EVAL_JUDGE_EMBED_DEVICE=cpu if the second copy of the model does not
# fit in VRAM alongside the retriever's copy.
EVAL_JUDGE_EMBED_DEVICE=

# On-disk cache of judge calls and embeddings (.ragas_cache). Delete it to force
# a re-score; keep it to make re-runs free and reproducible.
EVAL_CACHE_DIR=.ragas_cache
EVAL_OUTPUT_DIR=eval_runs

# Set to 0 to skip a scoring stage entirely.
EVAL_SCORE_ANSWERABLE=1
EVAL_SCORE_ABSTENTION=1
