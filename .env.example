# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM model via OpenRouter (https://openrouter.ai/models).
# Free tier examples: z-ai/glm-5.2:free, z-ai/glm-4.5-air:free, deepseek/deepseek-chat:free
LLM_MODEL=z-ai/glm-5.2:free
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=1
LLM_CONTEXT_WINDOW=256000

# LlamaParse API key: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-aIrzntqc50pq6zoc5CntiRHSzYkC7o7bmBbWlQMzOlSUijqm

# Qdrant (see docker-compose.yml)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Local embedding + reranking models (sentence-transformers)
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Retrieval / chunking
CHUNKER=markdown        # markdown (structure-aware) | sentence (fixed chunk_size)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=20                # candidates pulled from each leg before reranking
RERANK_TOP_N=3          # final passages passed to the LLM

# Hybrid retrieval (dense + lexical, fused inside Qdrant)
ENABLE_HYBRID=1                    # 0 = dense-only (original behaviour)
SPARSE_MODEL=Qdrant/bm25           # lexical leg: Qdrant/bm25 | prithivida/Splade_pp_en_v1
HYBRID_ALPHA=0.5                   # 0 = pure sparse, 1 = pure dense
SPARSE_TOP_K=20                    # candidates from the sparse leg (defaults to TOP_K)

# Metadata filtering (applied to BOTH the dense and sparse leg before fusion)
FILTERED_FIELDS=file_name,header_path,document_id
# Payload fields to build Qdrant payload indexes for, so filters stay indexed.
# Indexing is created on startup and is safe on an existing collection.
#
# DEFAULT_FILTERS is applied to every query unless --no-default-filters is passed.
# Multiple entries are separated by ";" and are combined with AND.
# Syntax:  key=value   key!=value   key>=value   key<=value   key>value   key<value   key~=value
#   =   exact match          ~=  full-text contains        > >= < <=  numeric range
# Example: DEFAULT_FILTERS=file_name=spec.pdf;header_path~=/Setup
DEFAULT_FILTERS=

# Where to place your PDFs
DATA_DIR=data
